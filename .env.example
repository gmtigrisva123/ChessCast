# ─── Payments (Stripe) ───────────────────────────────────────────────
# Leave empty = DEMO mode (simulated checkout, coins are credited in the browser).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Live AI commentary (optional) ───────────────────────────────────
# Leave empty = use the built-in, personality-driven commentary lines.
ANTHROPIC_API_KEY=

# ─── Contact form / waitlist email (optional, via Resend) ────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@chesscast.io

# ─── Accounts & database (Supabase, optional) ────────────────────────
# Leave empty = wallet stays in the browser (demo mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never prefix with NEXT_PUBLIC_. Used by the Stripe webhook to credit coins.
SUPABASE_SECRET_KEY=
